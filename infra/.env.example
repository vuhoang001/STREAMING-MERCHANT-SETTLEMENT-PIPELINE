# ─────────────────────────────────────────────────────────────
# Cấu hình hạ tầng lab. Copy sang .env rồi chỉnh nếu cần:
#   cp infra/.env.example infra/.env   (hoặc: make setup)
#
# Version GHIM CỨNG, không dùng :latest — lab phải tái lập được.
# Credential để mặc định cho dễ đọc. KHÔNG bê nguyên sang production.
# ─────────────────────────────────────────────────────────────

# ── Versions ──
FLINK_VERSION=1.19.1
REDPANDA_VERSION=v24.2.7
REDPANDA_CONSOLE_VERSION=v2.7.2
MINIO_VERSION=RELEASE.2024-10-13T13-34-11Z
MC_VERSION=RELEASE.2024-10-08T09-37-26Z
POSTGRES_VERSION=16
GRAFANA_VERSION=11.2.0
METABASE_VERSION=v0.50.21

# ── MinIO (lakehouse S3) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Postgres (CDC source + serving plane) ──
POSTGRES_USER=omnipay
POSTGRES_PASSWORD=omnipay
POSTGRES_DB=omnipay
